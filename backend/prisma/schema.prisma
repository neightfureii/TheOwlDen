generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  member
  moderator
  admin
}

enum ReadingStatus {
  want_to_read
  reading
  read
  did_not_finish
}

// ─── People ───────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(member)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  library    UserBook[]
  shelves    Shelf[]
  goals      ReadingGoal[]
  addedBooks Book[]   @relation("BookAddedBy")
  following  Follow[] @relation("Follower")
  followers  Follow[] @relation("Followed")

  @@map("users")
}

model Follow {
  followerId Int      @map("follower_id")
  followedId Int      @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@map("follows")
}

// ─── Catalog (shared by everyone) ─────────────────────────

model Author {
  id    Int     @id @default(autoincrement())
  name  String
  bio   String?
  books BookAuthor[]

  @@index([name])
  @@map("authors")
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  books BookGenre[]

  @@map("genres")
}

model Book {
  id          Int       @id @default(autoincrement())
  title       String
  subtitle    String?
  description String?
  isbn13      String?   @unique
  pageCount   Int?      @map("page_count")
  publisher   String?
  publishedOn DateTime? @map("published_on") @db.Date
  language    String    @default("en")
  coverUrl    String?   @map("cover_url")
  addedById   Int?      @map("added_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  addedBy   User?        @relation("BookAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  authors   BookAuthor[]
  genres    BookGenre[]
  userBooks UserBook[]

  @@index([title])
  @@map("books")
}

model BookAuthor {
  bookId   Int @map("book_id")
  authorId Int @map("author_id")
  position Int @default(0) // order for multi-author books

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@map("book_authors")
}

model BookGenre {
  bookId  Int @map("book_id")
  genreId Int @map("genre_id")

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@index([genreId])
  @@map("book_genres")
}

// ─── A user's relationship with a book ────────────────────

model UserBook {
  id             Int           @id @default(autoincrement())
  userId         Int           @map("user_id")
  bookId         Int           @map("book_id")
  status         ReadingStatus @default(want_to_read)
  rating         Int?          @db.SmallInt // 1-5, null = not rated
  review         String?
  reviewIsPublic Boolean       @default(true) @map("review_is_public")
  currentPage    Int           @default(0) @map("current_page")
  startedAt      DateTime?     @map("started_at") @db.Date
  finishedAt     DateTime?     @map("finished_at") @db.Date
  addedAt        DateTime      @default(now()) @map("added_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book         @relation(fields: [bookId], references: [id], onDelete: Restrict)
  shelfEntries ShelfEntry[]

  @@unique([userId, bookId]) // a book appears once in your library
  @@index([userId, status])
  @@index([bookId])
  @@map("user_books")
}

// ─── Custom shelves ("favourites", "comfort reads", ...) ──

model Shelf {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ShelfEntry[]

  @@unique([userId, name])
  @@map("shelves")
}

model ShelfEntry {
  shelfId    Int      @map("shelf_id")
  userBookId Int      @map("user_book_id")
  addedAt    DateTime @default(now()) @map("added_at")

  shelf    Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@id([shelfId, userBookId])
  @@index([userBookId])
  @@map("shelf_entries")
}

// ─── Yearly reading challenge ─────────────────────────────

model ReadingGoal {
  id          Int @id @default(autoincrement())
  userId      Int @map("user_id")
  year        Int
  targetBooks Int @map("target_books")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("reading_goals")
}